{% extends 'auth/base_auth.html' %}
{% load static %}

{% block auth_content %}
<div class="min-h-screen w-full bg-[#1a1a1a] relative">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Search Section -->
        <div class="mb-12">
            <h2 class="text-2xl font-bold text-white mb-6">Find Creators</h2>
            <form method="get" class="flex gap-4">
                <div class="flex-1">
                    <input type="text" name="search" value="{{ search_query }}" 
                           placeholder="Search by username or name" 
                           class="w-full px-4 py-3 bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-xl border border-[rgba(245,245,220,0.1)] text-white placeholder-gray-400 focus:outline-none focus:border-purple-500">
                </div>
                <button type="submit" class="px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-xl transition-colors">
                    <i class="fas fa-search"></i>
                </button>
            </form>
        </div>

        <!-- Connected Creators -->
        <div class="mb-12">
            <div class="flex justify-between items-center mb-6">
                <div>
                    <h2 class="text-xl font-semibold text-white">Mutual Connections</h2>
                    <p class="text-gray-400 text-sm">Users who have also linked with you</p>
                </div>
                <span class="text-gray-400">{{ linked_users|length }} connection{{ linked_users|length|pluralize }}</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for profile in linked_users %}
                <div class="bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-xl p-6 border border-[rgba(245,245,220,0.1)] transform transition-all hover:scale-[1.02] hover:bg-[rgba(40,40,40,0.6)]">
                    <div class="flex items-start gap-4">
                        {% if profile.profile_picture %}
                        <img src="{{ profile.profile_picture.url }}" alt="{{ profile.user.username }}" 
                             class="w-16 h-16 rounded-full object-cover border-2 border-purple-500">
                        {% else %}
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white text-xl font-bold border-2 border-purple-500">
                            {{ profile.user.username|make_list|first|upper }}
                        </div>
                        {% endif %}
                        
                        <div class="flex-1">
                            <h3 class="text-white font-semibold text-lg">{{ profile.user.get_full_name|default:profile.user.username }}</h3>
                            <p class="text-gray-400">@{{ profile.user.username }}</p>
                            
                            <div class="flex gap-4 mt-3 text-sm text-gray-300">
                                <span><i class="fas fa-users"></i> {{ profile.subscribers|default:"0" }}</span>
                                <span><i class="fas fa-eye"></i> {{ profile.total_views|default:"0" }}</span>
                                <span><i class="fas fa-video"></i> {{ profile.video_count|default:"0" }}</span>
                            </div>
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <a href="{% url 'view_profile' profile.user.username %}" 
                               class="text-purple-400 hover:text-purple-300 transition-colors">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                            <button onclick="disconnectUser('{{ profile.user.username }}')"
                                    class="px-4 py-1.5 bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-full border border-[rgba(245,245,220,0.1)] text-purple-400 hover:text-purple-300 transition-all hover:scale-[1.02] text-sm font-medium">
                                Unlink
                            </button>
                        </div>
                    </div>
                </div>
                {% empty %}
                <div class="col-span-full text-center py-12 text-gray-400">
                    <p>You haven't connected with any creators yet.</p>
                    <p class="mt-2">Use the search above to find and connect with other creators!</p>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Search Results -->
        {% if search_query %}
        <div class="mb-12">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-xl font-semibold text-white">Search Results</h2>
                <span class="text-gray-400">{{ search_results|length }} result{{ search_results|length|pluralize }}</span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for profile in search_results %}
                <div class="bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-xl p-6 border border-[rgba(245,245,220,0.1)] transform transition-all hover:scale-[1.02] hover:bg-[rgba(40,40,40,0.6)]">
                    <div class="flex items-start gap-4">
                        {% if profile.profile_picture %}
                        <img src="{{ profile.profile_picture.url }}" alt="{{ profile.user.username }}" 
                             class="w-16 h-16 rounded-full object-cover border-2 border-purple-500">
                        {% else %}
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white text-xl font-bold border-2 border-purple-500">
                            {{ profile.user.username|make_list|first|upper }}
                        </div>
                        {% endif %}
                        
                        <div class="flex-1">
                            <h3 class="text-white font-semibold text-lg">{{ profile.user.get_full_name|default:profile.user.username }}</h3>
                            <p class="text-gray-400">@{{ profile.user.username }}</p>
                            
                            <div class="flex gap-4 mt-3 text-sm text-gray-300">
                                <span><i class="fas fa-users"></i> {{ profile.subscribers|default:"0" }}</span>
                                <span><i class="fas fa-eye"></i> {{ profile.total_views|default:"0" }}</span>
                                <span><i class="fas fa-video"></i> {{ profile.video_count|default:"0" }}</span>
                            </div>
                        </div>
                        
                        <div class="flex flex-col gap-2">
                            <a href="{% url 'view_profile' profile.user.username %}" 
                               class="text-purple-400 hover:text-purple-300 transition-colors">
                                <i class="fas fa-external-link-alt"></i>
                            </a>
                            {% if profile.user != request.user %}
                                {% if profile.link_status == 'mutual' %}
                                <button onclick="disconnectUser('{{ profile.user.username }}')"
                                        class="px-4 py-1.5 bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-full border border-purple-400 text-purple-400 hover:text-purple-300 transition-all hover:scale-[1.02] text-sm font-medium">
                                    <i class="fas fa-link mr-1"></i> Mutual
                                </button>
                                {% elif profile.link_status == 'one-way' %}
                                <button onclick="disconnectUser('{{ profile.user.username }}')"
                                        class="px-4 py-1.5 bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-full border border-orange-400 text-orange-400 hover:text-orange-300 transition-all hover:scale-[1.02] text-sm font-medium">
                                    <i class="fas fa-angle-right mr-1"></i> Linked
                                </button>
                                {% else %}
                                <button onclick="connectUser('{{ profile.user.username }}')"
                                        class="px-4 py-1.5 bg-[rgba(30,30,30,0.6)] backdrop-blur-md rounded-full border border-[rgba(245,245,220,0.1)] text-purple-400 hover:text-purple-300 transition-all hover:scale-[1.02] text-sm font-medium">
                                    <i class="fas fa-plus mr-1"></i> Link
                                </button>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% empty %}
                <div class="col-span-full text-center py-12 text-gray-400">
                    <p>No users found matching your search.</p>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% block extra_js %}
{{ block.super }}
<script>
    // Define the functions globally
    function connectUser(username) {
        fetch(`/network/connect/${username}/`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': getCookie('csrftoken'),
                'Content-Type': 'application/json'
            }

        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.error || 'Error connecting with user');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error connecting with user');
        });
    }

    function disconnectUser(username) {
        if (!confirm('Are you sure you want to unlink from this user?')) {
            return;
        }

        fetch(`/network/disconnect/${username}/`, {
            method: 'POST',
            headers: {
                'X-CSRFToken': getCookie('csrftoken'),
                'Content-Type': 'application/json'
            }

        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert(data.error || 'Error disconnecting from user');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error disconnecting from user');
        });
    }

    function getCookie(name) {
        let cookieValue = null;
        if (document.cookie && document.cookie !== '') {
            const cookies = document.cookie.split(';');
            for (let i = 0; i < cookies.length; i++) {
                const cookie = cookies[i].trim();
                if (cookie.substring(0, name.length + 1) === (name + '=')) {
                    cookieValue = decodeURIComponent(cookie.substring(name.length + 1));
                    break;
                }
            }
        }
        return cookieValue;
    }
    
    // Wait for DOM to be ready
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Network script loaded');
        // Any initialization code can go here
    });
</script>
{% endblock extra_js %}
{% endblock auth_content %} 
